# OS cruft
.DS_Store

# Editor/runtime state we don't want tracked
*.swp

# nvim: lazy-lock.json IS tracked (LazyVim convention) for reproducible plugin versions.

# herdr: track only config.*.toml (config.toml is generated from them by
# zsh/.zshrc at shell startup); the rest is runtime state (sockets, logs, sessions)
# or machine-specific (plugins.json holds absolute plugin paths)
herdr/.config/herdr/*
!herdr/.config/herdr/config.*.toml
# ...and herdr-radar's settings + render hook (its other files there are runtime state)
!herdr/.config/herdr/plugins/
herdr/.config/herdr/plugins/*
!herdr/.config/herdr/plugins/config/
herdr/.config/herdr/plugins/config/*
!herdr/.config/herdr/plugins/config/hhdebb.herdr-radar/
herdr/.config/herdr/plugins/config/hhdebb.herdr-radar/*
!herdr/.config/herdr/plugins/config/hhdebb.herdr-radar/config.toml
!herdr/.config/herdr/plugins/config/hhdebb.herdr-radar/model-hook.js
